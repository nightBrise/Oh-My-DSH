{
  "name": "dsh-webui-enhance",
  "description": "DSH Web GUI 增强插件:Token 用量统计、产物右侧预览、Deep 文案池、@文件提及、会话删除",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "plugin",
    "token-usage",
    "preview"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  }
