{
  "name": "dsh-badgeboard",
  "description": "DSH 子代理工牌板（Badge Board）：中栏右缘悬浮胶囊（在线头像栈 + hover 信息卡）+ details 栏「团队」分段（随机线稿头像、职级色环、状态点、工作进度条）；Host 侧捕获 dispatch 档案（type/tier/persona）。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "plugin",
    "subagent",
    "badge-board"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
